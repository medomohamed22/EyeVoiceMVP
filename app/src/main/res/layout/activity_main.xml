<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eye Voice MVP 0.2"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر طريقة الاختيار:"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/modeVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النظر بالبؤبؤ + قل «افتح» أو «اضغط»"/>

            <RadioButton
                android:id="@+id/modeBlink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="النظر بالبؤبؤ + رمشتان للاختيار"/>
        </RadioGroup>

        <Button
            android:id="@+id/permissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. صلاحيات الكاميرا والمايك"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. السماح بالظهور فوق التطبيقات"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. فتح إعدادات Accessibility"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/trainingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. اختبار وتعلّم + معايرة 9 نقاط"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. تشغيل التحكم"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إيقاف"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nأوامر الصوت: افتح / اضغط / ارجع / الرئيسية / انزل / اطلع.\n\nيفضل إعادة المعايرة عند تغيير زاوية الهاتف أو المسافة بشكل كبير."
            android:textSize="15sp"/>
    </LinearLayout>
</ScrollView>
